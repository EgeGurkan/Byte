; GPU Material Error Fix - Enable Hardware Accelerated GPU Scheduling
; https://www.elevenforum.com/t/turn-on-or-off-hardware-accelerated-gpu-scheduling-in-windows-11.852/
; Turns on Hardware-accelerated GPU scheduling and changes TDR settings (TdrLevel 0 = no GPU timeout recovery).
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\GraphicsDrivers]
"TdrLevel"=dword:00000000
"TdrDelay"=dword:00000064
"HwSchMode"=dword:00000002

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"TdrLevel"=dword:00000000
"TdrDelay"=dword:00000064
"HwSchMode"=dword:00000002

; Disable AMD Context Menu
; Blocks the AMD Software shell extension on the desktop context menu.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Blocked]
"{FDADFEE3-02D1-4E7C-A511-380F4C98D73B}"=""

; Disable Nvidia Context Menu
; Hides the NVIDIA Control Panel entry from the desktop context menu.
[HKEY_CURRENT_USER\Software\NVIDIA Corporation\Global\NvCplApi\Policies]
"ContextUIPolicy"=dword:00000000

; Disable Intel Context Menu
; Removes Intel graphics entries from the desktop context menu.
[-HKEY_CLASSES_ROOT\Directory\Background\shellex\ContextMenuHandlers\igfxcui]
[-HKEY_CLASSES_ROOT\Directory\Background\shellex\ContextMenuHandlers\igfxDTCM]

; Force .Net Latest Version
; Commented out: would make .NET apps roll forward to the latest installed major runtime.
; [HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Environment]
; "DOTNET_ROLL_FORWARD"="LatestMajor"
; [HKEY_CURRENT_USER\Environment]
; "DOTNET_ROLL_FORWARD"="LatestMajor"