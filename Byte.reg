"MaximumRecordLength"=hex(b):00,34,e2,30,04,00,00,00
"VideoEncodingFrameRateMode"=dword:00000001
"VideoEncodingBitrateMode"=dword:00000001
"AudioCaptureEnabled"=dword:00000001
"EnablePerAppAudio"=dword:00000001
"HistoricalCaptureEnabled"=dword:00000001

; Disable Windows Spotlight on Desktop Background
; https://www.elevenforum.com/t/enable-or-disable-windows-spotlight-on-desktop-background-in-windows-11.18246/
