; CleanUp - Context Menu Entries To Use RunAsTI
; Removes old entries; the sections below add a "TrustedInstaller" context menu (.bat/.cmd/.exe/.msc/.ps1/.reg/folders) that runs via C:\Byte\Admin.exe.
[-HKEY_CLASSES_ROOT\RunAsTI]
[-HKEY_CLASSES_ROOT\batfile\shell\Byte]
[-HKEY_CLASSES_ROOT\cmdfile\shell\Byte]
[-HKEY_CLASSES_ROOT\exefile\shell\Byte]
[-HKEY_CLASSES_ROOT\mscfile\shell\Byte]
[-HKEY_CLASSES_ROOT\Microsoft.PowerShellScript.1\shell\Byte]
[-HKEY_CLASSES_ROOT\SystemFileAssociations\.ps1\shell\Byte]
[-HKEY_CLASSES_ROOT\regfile\shell\Byte]
[-HKEY_CLASSES_ROOT\Folder\shell\Byte]
[-HKEY_CLASSES_ROOT\Directory\background\shell\extract]

; RunAsTI on .bat
[HKEY_CLASSES_ROOT\batfile\shell\Byte]
"MUIVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="cmd.exe,0"
"Position"="Middle"
[HKEY_CLASSES_ROOT\batfile\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller \"%1\""

; RunAsTI on .cmd
[HKEY_CLASSES_ROOT\cmdfile\shell\Byte]
"MUIVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="cmd.exe,0"
"Position"="Middle"
[HKEY_CLASSES_ROOT\cmdfile\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller \"%1\""

; RunAsTI on .exe
[HKEY_CLASSES_ROOT\exefile\shell\Byte]
"MUIVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="cmd.exe,0"
"Position"="Middle"
[HKEY_CLASSES_ROOT\exefile\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller \"%1\""

; RunAsTI on .msc
[HKEY_CLASSES_ROOT\mscfile\shell\Byte]
"MUIVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="cmd.exe,0"
"Position"="Middle"
[HKEY_CLASSES_ROOT\mscfile\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller \"%1\""

; RunAsTI on .ps1 (Düzeltilmiş Anahtar Yapısı)
[HKEY_CLASSES_ROOT\Microsoft.PowerShellScript.1\shell\Byte]
"MUIVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="powershell.exe,0"
"Position"="Middle"
[HKEY_CLASSES_ROOT\Microsoft.PowerShellScript.1\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller powershell.exe -ExecutionPolicy Bypass -NoProfile -File \"%1\""

[HKEY_CLASSES_ROOT\SystemFileAssociations\.ps1\shell\Byte]
"MUIVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="powershell.exe,0"
"Position"="Middle"
[HKEY_CLASSES_ROOT\SystemFileAssociations\.ps1\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller powershell.exe -ExecutionPolicy Bypass -NoProfile -File \"%1\""

; RunAsTI on .reg
[HKEY_CLASSES_ROOT\regfile\shell\Byte]
"MUIVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="regedit.exe,0"
"Position"="Middle"
[HKEY_CLASSES_ROOT\regfile\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller regedit.exe /s \"%1\""

; RunAsTI on Folder
[HKEY_CLASSES_ROOT\Folder\shell\Byte]
"MuiVerb"="TrustedInstaller"
"HasLUAShield"=""
"Icon"="cmd.exe,0"
"Position"="Middle"
"AppliesTo"="NOT System.ParsingName:=\"::{645FF040-5081-101B-9F08-00AA002F954E}\""
[HKEY_CLASSES_ROOT\Folder\shell\Byte\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged --TrustedInstaller cmd.exe /k cd /d \"%1\""

; Take Ownership (Files)
; https://www.elevenforum.com/t/add-take-ownership-to-context-menu-in-windows-11.1230/
; Adds "Ownership" to the Shift + right-click menu of files: takes ownership and grants full control.
[HKEY_CLASSES_ROOT\*\Shell\Ownership]
@="Ownership"
"Icon"="imageres.dll,-88"
"Extended"=""
"Position"="Middle"
"HasLUAShield"=""
"NoWorkingDirectory"=""

[HKEY_CLASSES_ROOT\*\Shell\Ownership\Command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged cmd.exe /c takeown /f \"%1\" && icacls \"%1\" /grant *S-1-3-4:F /t /c /l"
"IsolatedCommand"="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged cmd.exe /c takeown /f \"%1\" && icacls \"%1\" /grant *S-1-3-4:F /t /c /l"

