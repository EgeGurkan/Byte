; Disable Feedback Notifications
; https://www.elevenforum.com/t/change-feedback-frequency-in-windows-11.7614/
; Stops Windows from asking for feedback (Feedback frequency = Never) by policy.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection]
"DoNotShowFeedbackNotifications"=dword:00000001

; Enable This PC To Access Mobile Devices
; https://www.elevenforum.com/t/enable-or-disable-allow-pc-to-access-your-mobile-devices-in-windows-11.20862/
; Turns on "Allow this PC to access your mobile devices" (use phone as connected camera, etc.).
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Mobility]
"CrossDeviceEnabled"=dword:00000001

