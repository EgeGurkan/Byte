@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged wsl.exe --cd \"%V\""

; Remove Open Command Prompt Here From Right Click Context Menu
; Removes the legacy "Open command window here" Shift + right-click entries.
[-HKEY_CLASSES_ROOT\DesktopBackground\shell\CommandPrompt]
[-HKEY_CLASSES_ROOT\Directory\shell\CommandPrompt]
[-HKEY_CLASSES_ROOT\Directory\Background\shell\CommandPrompt]
[-HKEY_CLASSES_ROOT\Drive\shell\CommandPrompt]
[-HKEY_CLASSES_ROOT\LibraryFolder\Background\shell\CommandPrompt]

; Remove Open Powershell Here From Right Click Context Menu
; https://www.elevenforum.com/t/add-or-remove-open-powershell-window-here-context-menu-in-windows-11.20899/
; Removes "Open PowerShell window here" from the Shift + right-click menu.
[-HKEY_CLASSES_ROOT\Directory\Background\shell\PowerShell]
[-HKEY_CLASSES_ROOT\Directory\shell\PowerShell]
[-HKEY_CLASSES_ROOT\Drive\shell\PowerShell]
[-HKEY_CLASSES_ROOT\LibraryFolder\Background\shell\PowerShell]

; Remove Open Linux Shell Here From Right Click Context Menu
; https://www.elevenforum.com/t/add-or-remove-open-linux-shell-here-context-menu-in-windows-11.20962/
; Removes "Open Linux shell here" (added by WSL) from the context menu.
[-HKEY_CLASSES_ROOT\Directory\background\shell\WSL]
[-HKEY_CLASSES_ROOT\Drive\shell\WSL]
[-HKEY_CLASSES_ROOT\Directory\shell\WSL]

; Remove Git From Right Click Context Menu
; Hides Git GUI/Git Bash Here entries from the folder context menu.
[HKEY_CLASSES_ROOT\Directory\Background\shell\git_gui]
"LegacyDisable"=""

[HKEY_CLASSES_ROOT\Directory\Background\shell\git_shell]
"LegacyDisable"=""

[HKEY_CLASSES_ROOT\Directory\shell\git_gui]
"LegacyDisable"=""

[HKEY_CLASSES_ROOT\Directory\shell\git_shell]
"LegacyDisable"=""

; Remove Tailscale From Right Click Context Menu
; Hides the Tailscale entry from the file context menu.
[HKEY_CLASSES_ROOT\*\shell\tailscale]
"LegacyDisable"=""

; Add Hash Value To Shift Right Click
; https://www.elevenforum.com/t/add-hash-value-to-context-menu-of-files-in-windows-11.22212/
; Adds a "Hash" submenu (Shift + right-click) to show a file's MD5/SHA/other hashes.
[HKEY_CLASSES_ROOT\*\Shell\Hash]
"Icon"="imageres.dll,-198"
"MUIVerb"="Hash"
"Extended"=""
"Position"="Middle"
"SubCommands"=""

; MD5
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\01Menu]
"MUIVerb"="MD5"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\01Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $file=[string]$input; get-filehash -literalpath $file.substring(2,$file.length - 5) -algorithm MD5 ^| format-list; Start-Sleep 3600"

; SHA1
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\02Menu]
"MUIVerb"="SHA1"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\02Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $file=[string]$input; get-filehash -literalpath $file.substring(2,$file.length - 5) -algorithm SHA1 ^| format-list; Start-Sleep 3600"

; SHA256
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\03Menu]
"MUIVerb"="SHA256"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\03Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $file=[string]$input; get-filehash -literalpath $file.substring(2,$file.length - 5) -algorithm SHA256 ^| format-list; Start-Sleep 3600"

; SHA384
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\04Menu]
"MUIVerb"="SHA384"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\04Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $file=[string]$input; get-filehash -literalpath $file.substring(2,$file.length - 5) -algorithm SHA384 ^| format-list; Start-Sleep 3600"

; SHA512
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\05Menu]
"MUIVerb"="SHA512"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\05Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $file=[string]$input; get-filehash -literalpath $file.substring(2,$file.length - 5) -algorithm SHA512 ^| format-list; Start-Sleep 3600"

; MACTripleDES
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\06Menu]
"MUIVerb"="MACTripleDES"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\06Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $file=[string]$input; get-filehash -literalpath $file.substring(2,$file.length - 5) -algorithm MACTripleDES ^| format-list; Start-Sleep 3600"

; RIPEMD160
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\07Menu]
"MUIVerb"="RIPEMD160"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\07Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $file=[string]$input; get-filehash -literalpath $file.substring(2,$file.length - 5) -algorithm RIPEMD160 ^| format-list; Start-Sleep 3600"

; Show All Hashes
[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\08Menu]
"CommandFlags"=dword:00000020
"MUIVerb"="Show all"

[HKEY_CLASSES_ROOT\*\Shell\Hash\Shell\08Menu\Command]
@="cmd /c echo \\\"%1\\\" | powershell -nop $raw=[string]$input; $file=$raw.substring(2,$raw.length - 5); \\\"Path:`n$file`n\\\"; @(foreach ($a in @('MD5','SHA1','SHA256','SHA384','SHA512','MACTripleDES','RIPEMD160')) { get-filehash -literalpath $file -algorithm $a }) ^| foreach { \\\"$($_.Algorithm):`n$($_.Hash)`n\\\" }; Start-Sleep 3600"

; Take Ownership (Folders)
; https://www.elevenforum.com/t/add-take-ownership-to-context-menu-in-windows-11.1230/
; Adds "Ownership" to the Shift + right-click menu of folders (protected system folders excluded).
[HKEY_CLASSES_ROOT\Directory\Shell\Ownership]
@="Ownership"
"Icon"="imageres.dll,-88"
"Extended"=""
"Position"="Middle"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"AppliesTo"="NOT (System.ItemPathDisplay:=\"C:\\Users\" OR System.ItemPathDisplay:=\"C:\\ProgramData\" OR System.ItemPathDisplay:=\"C:\\Windows\" OR System.ItemPathDisplay:=\"C:\\Windows\\System32\" OR System.ItemPathDisplay:=\"C:\\Program Files\" OR System.ItemPathDisplay:=\"C:\\Program Files (x86)\")"

[HKEY_CLASSES_ROOT\Directory\Shell\Ownership\Command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged cmd.exe /c takeown /f \"%1\" /r /d y && icacls \"%1\" /grant *S-1-3-4:F /t /c /l /q"
"IsolatedCommand"="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged cmd.exe /c takeown /f \"%1\" /r /d y && icacls \"%1\" /grant *S-1-3-4:F /t /c /l /q"

; Take Ownership (Drives Except System)
; https://www.elevenforum.com/t/add-take-ownership-to-context-menu-in-windows-11.1230/
; Adds "Ownership" to the Shift + right-click menu of drives except C:.
[HKEY_CLASSES_ROOT\Drive\Shell\Runas]
@="Ownership"
"Icon"="imageres.dll,-88"
"Extended"=""
"Position"="Middle"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"AppliesTo"="NOT (System.ItemPathDisplay:=\"C:\\\")"

[HKEY_CLASSES_ROOT\Drive\shell\runas\command]
@="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged cmd.exe /c takeown /f \"%1\\\" /r /d y && icacls \"%1\\\" /grant *S-1-3-4:F /t /c"
"IsolatedCommand"="\"C:\\Byte\\Admin.exe\" --NoLogo --Privileged cmd.exe /c takeown /f \"%1\\\" /r /d y && icacls \"%1\\\" /grant *S-1-3-4:F /t /c"

