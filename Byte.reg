"AutoGameModeEnabled"=dword:00000001

; Enable Windowed Optimizations - Enable Variable Refresh Rate - Disable AutoHDR
; https://www.elevenforum.com/t/turn-on-or-off-optimizations-for-windowed-games-in-windows-11.4943/
; https://www.elevenforum.com/t/enable-or-disable-variable-refresh-rate-for-games-in-windows-11.12052/
; https://www.elevenforum.com/t/turn-on-or-off-auto-hdr-in-windows-11.891/
; Turns on optimizations for windowed games and VRR, and turns off Auto HDR.
[HKEY_CURRENT_USER\Software\Microsoft\DirectX\GraphicsSettings]
"SwapEffectUpgradeCache"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\DirectX\UserGpuPreferences]
"DirectXUserGlobalSettings"="VRROptimizeEnable=1;AutoHDREnable=0;SwapEffectUpgradeEnable=1;"

; Enable Fullscreen Optimizations
; https://www.elevenforum.com/t/enable-or-disable-fullscreen-optimizations-for-games-in-windows-11.4945/
; Keeps fullscreen optimizations on globally (FSE behavior = default).
[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000000
"GameDVR_FSEBehaviorMode"=dword:00000000
"GameDVR_HonorUserFSEBehaviorMode"=dword:00000000
"GameDVR_DXGIHonorFSEWindowsCompatible"=dword:00000000
"GameDVR_EFSEFeatureFlags"=dword:00000000

; Enable Capture & GameDVR Settings
; https://www.elevenforum.com/t/enable-or-disable-game-recording-for-captures-in-windows-11.17611/
; https://www.elevenforum.com/t/enable-or-disable-record-what-happened-for-gaming-captures-in-windows-11.17900/
; Removes the policy blocking game recording, and presets capture options (length, frame rate, bitrate, audio, background recording).
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\GameDVR]
"AllowGameDVR"=-

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\ApplicationManagement\AllowGameDVR]
