Windows Registry Editor Version 5.00

; Disable UAC
; https://www.elevenforum.com/t/change-user-account-control-uac-settings-in-windows-11.1523/
; https://www.elevenforum.com/t/change-uac-behavior-for-administrators-in-windows-11.14782/
; https://www.elevenforum.com/t/change-uac-behavior-for-standard-users-in-windows-11.13032/
; Keeps UAC on (EnableLUA=1) but admins elevate silently without the secure desktop; standard users' elevation requests are auto-denied.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"PromptOnSecureDesktop"=dword:00000000
"ConsentPromptBehaviorAdmin"=dword:00000000
"ConsentPromptBehaviorUser"=dword:00000000
"EnableLUA"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\UIPI]
@="0x00000001(1)"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies]
"FilterAdministratorToken"=dword:00000001

; Disable SAC
; https://www.elevenforum.com/t/turn-on-or-off-smart-app-control-in-windows-11.4996/
; Sets Smart App Control to Off so unknown/unsigned apps are not blocked.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\CI\Policy]
"VerifiedAndReputablePolicyState"=dword:00000000

; ============================================================================
; Disable Reputation-Based Protection (Geçmiş Temelli Koruma - Tamamı)
; ============================================================================

; 1. Check Apps and Files (Uygulamaları ve dosyaları denetleyin)
; https://www.elevenforum.com/t/enable-or-disable-microsoft-defender-smartscreen-check-apps-and-files-from-web-in-windows-11.5731/
; Turns off SmartScreen checks for apps and files downloaded from the web.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System]
"EnableSmartScreen"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer]
"SmartScreenEnabled"="Off"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender\SmartScreen]
"ConfigureAppInstallControlEnabled"=dword:00000000

; 2. SmartScreen for Microsoft Edge (Microsoft Edge için SmartScreen)
; https://www.elevenforum.com/t/enable-or-disable-microsoft-defender-smartscreen-for-microsoft-edge-in-windows-11.5758/
; https://www.elevenforum.com/t/enable-or-disable-potentially-unwanted-app-pua-protection-in-microsoft-edge.24795/
; Turns off SmartScreen and potentially unwanted app (PUA) blocking in Edge (legacy and Chromium policies).
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\MicrosoftEdge\PhishingFilter]
"EnabledV9"=dword:00000000
"PreventOverride"=dword:00000000

[HKEY_CURRENT_USER\Software\Policies\Microsoft\MicrosoftEdge\PhishingFilter]
"EnabledV9"=dword:00000000
"PreventOverride"=dword:00000000

[HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppContainer\Storage\microsoft.microsoftedge_8wekyb3d8bbwe\MicrosoftEdge\PhishingFilter]
"EnabledV9"=dword:00000000
"PreventOverride"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"SmartScreenEnabled"=dword:00000000
"SmartScreenPuaEnabled"=dword:00000000

[HKEY_CURRENT_USER\Software\Policies\Microsoft\Edge]
"SmartScreenEnabled"=dword:00000000
"SmartScreenPuaEnabled"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Edge\SmartScreenEnabled]
@=dword:00000000

; 3. Phishing Protection (Kimlik avından korunma ve alt kutucukları)
; https://www.elevenforum.com/t/enable-or-disable-microsoft-defender-smartscreen-phishing-protection-windows-11.5721/
; Turns off phishing protection and its warnings (malicious sites, password reuse, unsafe password storage).
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WTDS\Components]
"ServiceEnabled"=dword:00000000
"NotifyMalicious"=dword:00000000
"NotifyPasswordReuse"=dword:00000000
"NotifyUnsafeApp"=dword:00000000
"CaptureThreatWindow"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\WTDS\Components]
"ServiceEnabled"=dword:00000000
"NotifyMalicious"=dword:00000000
"NotifyPasswordReuse"=dword:00000000
"NotifyUnsafeApp"=dword:00000000
"CaptureThreatWindow"=dword:00000000

; 4. Potentially Unwanted App Blocking (İstenmeyebilecek uygulama engelleme)
; https://www.elevenforum.com/t/enable-or-disable-microsoft-defender-pua-protection-in-windows-11.5762/
; Turns off Microsoft Defender potentially unwanted app (PUA) blocking.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender]
"PUAProtection"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender\MpEngine]
"MpEnablePus"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender\MpEngine]
"MpEnablePus"=dword:00000000

; 5. SmartScreen for Microsoft Store Apps (Microsoft Store uygulamaları için SmartScreen)
; https://www.elevenforum.com/t/enable-or-disable-microsoft-defender-smartscreen-for-microsoft-store-apps-in-windows-11.5736/
; Stops SmartScreen from checking web content (URLs) used by Microsoft Store apps.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\AppHost]
"EnableWebContentEvaluation"=dword:00000000
"PreventOverride"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\AppHost]
"EnableWebContentEvaluation"=dword:00000000
"PreventOverride"=dword:00000000

; ============================================================================

; Disable Vulnerable Driver Blocklist
; https://www.elevenforum.com/t/enable-or-disable-microsoft-vulnerable-driver-blocklist-in-windows-11.10031/
; Allows drivers on Microsoft's vulnerable driver blocklist to load (needed by some older tools/anti-cheat). Restart required.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\CI\Config]
"VulnerableDriverBlocklistEnable"=dword:00000000

; Install Store Apps From Anywhere
; https://www.elevenforum.com/t/choose-where-to-get-apps-in-windows-11.7370/
; Sets "Choose where to get apps" to Anywhere, so installers outside the Microsoft Store are not blocked or warned about.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer]
"AicEnabled"="Anywhere"

; Disable Windows Security Virus and Thread Protection Non Critical Notifications
; https://www.elevenforum.com/t/enable-or-disable-windows-security-virus-and-threat-protection-notifications.10185/
; Hides non-critical (informational) Virus & threat protection notifications; critical alerts still show.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender Security Center\Notifications]
"DisableEnhancedNotifications"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender Security Center\Notifications]
"DisableNotifications"=-

; Disable Windows Security Account Protection Notifications
; https://www.elevenforum.com/t/enable-or-disable-windows-security-account-protection-notifications.10189/
; Stops Account protection notifications, including Windows Hello and Dynamic lock prompts.
[HKEY_CURRENT_USER\Software\Microsoft\Windows Defender Security Center\Account protection]
"DisableNotifications"=dword:00000001
"DisableWindowsHelloNotifications"=dword:00000001
"DisableDynamiclockNotifications"=dword:00000001

; Disable Windows Security Firewall Notifications
; https://www.elevenforum.com/t/enable-or-disable-microsoft-defender-firewall-notifications-in-windows-11.10210/
; Stops firewall "blocked app" notifications for Domain, Private and Public networks.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\DomainProfile]
"DisableNotifications"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\PublicProfile]
"DisableNotifications"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\StandardProfile]
"DisableNotifications"=dword:00000001

; Edit Region
; https://www.elevenforum.com/t/change-country-or-region-geographic-location-geoid-in-windows-11.4034/
; Sets the device region and the default user's Geo location to United States (GeoID 244 = dword 0xF4 / string "244").
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Control Panel\DeviceRegion]
"DeviceRegion"=dword:000000f4

[HKEY_USERS\.DEFAULT\Control Panel\International\Geo]
"Nation"="244"
"Name"="US"

; Bypass Restrictions
; https://www.elevenforum.com/t/bypass-windows-11-system-requirements-on-unsupported-pc.1989/
; https://www.elevenforum.com/t/remove-system-requirements-not-met-watermark-on-windows-11-desktop.5241/
; https://www.elevenforum.com/t/clean-install-windows-11.99/
; Skips TPM/Secure Boot/CPU/RAM/storage checks, hides the "System requirements not met" notices and allows offline account setup (BypassNRO).
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\CompatMarkers]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Shared]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\TargetVersionUpgradeExperienceIndicators]

[HKEY_LOCAL_MACHINE\SYSTEM\Setup\LabConfig]
"BypassSecureBootCheck"=dword:00000001
"BypassTPMCheck"=dword:00000001
"BypassCPUCheck"=dword:00000001
"BypassRAMCheck"=dword:00000001
"BypassStorageCheck"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\Setup\MoSetup]
"AllowUpgradesWithUnsupportedTPMOrCPU"=dword:00000001

[HKEY_CURRENT_USER\Control Panel\UnsupportedHardwareNotificationCache]
"SV1"=dword:00000000
"SV2"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"HideUnsupportedHardwareNotifications"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE]
"BypassNRO"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\HwReqChk]
"HwReqChkVars"=hex(7):53,00,51,00,5f,00,53,00,65,00,63,00,75,00,72,00,65,00,42,\
  00,6f,00,6f,00,74,00,43,00,61,00,70,00,61,00,62,00,6c,00,65,00,3d,00,54,00,\
  52,00,55,00,45,00,00,00,53,00,51,00,5f,00,53,00,65,00,63,00,75,00,72,00,65,\
  00,42,00,6f,00,6f,00,74,00,45,00,6e,00,61,00,62,00,6c,00,65,00,64,00,3d,00,\
  54,00,52,00,55,00,45,00,00,00,53,00,51,00,5f,00,54,00,70,00,6d,00,56,00,65,\
  00,72,00,73,00,69,00,6f,00,6e,00,3d,00,32,00,00,00,53,00,51,00,5f,00,52,00,\
  61,00,6d,00,4d,00,42,00,3d,00,38,00,31,00,39,00,32,00,00,00,00,00

; Enable Developer Mode
; https://www.elevenforum.com/t/enable-or-disable-developer-mode-in-windows-11.928/
; Turns on Developer Mode so apps can be sideloaded and run from loose files.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock]
"AllowDevelopmentWithoutDevLicense"=dword:00000001
"AllowAllTrustedApps"=dword:00000001

; Enable Fast Startup
; https://www.elevenforum.com/t/turn-on-or-off-fast-startup-in-windows-11.1212/
; Turns on Fast Startup (hybrid shutdown) for quicker boots after a shut down. Requires hibernation to be available.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Power]
"HiberbootEnabled"=dword:00000001

; Enable Sudo
; https://www.elevenforum.com/t/enable-or-disable-sudo-command-in-windows-11.22329/
; Turns on the sudo command in Inline mode (3), so elevated commands run in the current console window.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Sudo]
"Enabled"=dword:00000003

; Enable Windows Script Host
; Makes sure Windows Script Host is enabled so .vbs/.js scripts can run.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Script Host\Settings]
"Enabled"=dword:00000001

; Turn On End Task in Taskbar By Right Click
; https://www.elevenforum.com/t/enable-or-disable-end-task-in-taskbar-by-right-click-in-windows-11.14325/
; Adds "End task" to the right-click menu of apps on the taskbar.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced\TaskbarDeveloperSettings]
"TaskbarEndTask"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\DeveloperSettings]
"TaskbarEndTask"=dword:00000001

; Turn On Use Print Screen Key To Launch Screen Snipping
; https://www.elevenforum.com/t/enable-or-disable-use-print-screen-key-to-open-screen-snipping-in-windows-11.520/
; Makes the Print Screen key open the Snipping Tool overlay.
[HKEY_CURRENT_USER\Control Panel\Keyboard]
"PrintScreenKeyForSnippingEnabled"=dword:00000001

; Turn Off Sticky Keys
; https://www.elevenforum.com/t/enable-or-disable-keyboard-shortcut-for-sticky-keys-in-windows-11.50886/
; Turns off Sticky Keys and stops pressing Shift five times from turning it on.
[HKEY_CURRENT_USER\Control Panel\Accessibility\StickyKeys]
"Flags"="26"

; Turn Off Filter Keys & Toggle Keys Keyboard Shortcuts
; https://www.elevenforum.com/t/enable-or-disable-keyboard-shortcut-for-filter-keys-in-windows-11.50888/
; https://www.elevenforum.com/t/enable-or-disable-keyboard-shortcut-for-toggle-keys-in-windows-11.50889/
; Stops right Shift (8 sec) and Num Lock (5 sec) from accidentally turning these on.
[HKEY_CURRENT_USER\Control Panel\Accessibility\Keyboard Response]
"Flags"="122"

[HKEY_CURRENT_USER\Control Panel\Accessibility\ToggleKeys]
"Flags"="58"

; Enable Long Path Support
; https://www.elevenforum.com/t/enable-or-disable-win32-long-paths-in-windows-11.38860/
; Removes the 260-character MAX_PATH limit for apps that support long paths.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem]
"LongPathsEnabled"=dword:00000001

; Allow Double Clicking To PS1 Files
; Makes double-clicking a .ps1 file run it in PowerShell (no profile, ExecutionPolicy Bypass) instead of opening it in Notepad.
[HKEY_CLASSES_ROOT\Applications\powershell.exe\shell\open\command]
@="\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -Command \"& '%1' | Out-String -Width 9999\""

[HKEY_CLASSES_ROOT\.ps1]
@="Microsoft.PowerShellScript.1"

[HKEY_CLASSES_ROOT\Microsoft.PowerShellScript.1\Shell\Open\Command]
@="\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -Command \"& '%1' | Out-String -Width 9999\""

; To Allow Mapped Drives To Be Available In Elevated PowerShell
; https://www.elevenforum.com/t/enable-or-disable-mapped-drives-available-in-elevated-command-prompt-in-windows-11.41838/
; Makes mapped network drives also visible in elevated (admin) Command Prompt/PowerShell windows. Restart required.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"EnableLinkedConnections"=dword:00000001

; Disable Point-In Time Restore
; https://www.elevenforum.com/t/enable-or-disable-point-in-time-restore-in-windows-11.42394/
; Turns off the Point-in-time restore recovery feature (and its periodic restore points).
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\Recovery\PITR\Settings]
"Active_UX"=dword:00000000

; Disable System Restore
; https://www.elevenforum.com/t/enable-or-disable-system-restore-in-windows-11.15866/
; Turns off System Restore by policy, so no restore points are created.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows NT\SystemRestore]
"DisableSR"=dword:00000001

; Turn Off Error Reporting
; Turns off Windows Error Reporting, so crash reports are not collected or sent to Microsoft.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\Windows Error Reporting]
"Disabled"=dword:00000001

; Disable 7GB Reserved Update Space
; https://www.elevenforum.com/t/enable-or-disable-reserved-storage-in-windows-11.21389/
; Turns off Reserved Storage, freeing the ~7 GB Windows keeps for updates. Applies after the next update/restart.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\ReserveManager]
"ShippedWithReserves"=dword:00000000

; Allow Log-In Without Typing Password
; https://www.elevenforum.com/t/enable-or-disable-passwordless-sign-in-for-microsoft-accounts-in-windows-11.834/
; Turns off "Only allow Windows Hello sign-in for Microsoft accounts", so password-based options (and netplwiz auto sign-in) are available again.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\PasswordLess\Device]
"DevicePasswordLessBuildVersion"=dword:00000000

; Disable Warnings At Opening Files For Publisher & Block From Downloaded Files
; https://www.elevenforum.com/t/unblock-file-downloaded-from-internet-in-windows-11.1125/
; Treats the listed file types as low risk (no "Open File - Security Warning") and stops tagging downloads with Mark of the Web.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Associations]
"LowRiskFileTypes"=".zip;.rar;.7z;.wim;.esd;.nfo;.txt;.epub;.mobi;.docx;.xlsx;.pptx;.pdf;.com;.htm;.html;.exe;.msi;.bat;.cmd;.ps1;.vbs;.reg;.psd;.psb;.ai;.dwg;.dxf;.obj;.fbx;.blend;.dae;.skp;.3ds;.3dm;.gh;.max;.rvt;.rdc;.gha;.wfp;.raw;.tif;.tiff;.webp;.gif;.bmp;.png;.hevc;.heic;.heif;.jpg;.jpeg;.avi;.mp4;.mpg;.mpeg;.mov;.mkv;.mp3;.m3u;.wav;"
"DefaultFileTypeRisk"=dword:00006152

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments]
"SaveZoneInformation"=dword:00000001

; Allow Share On Lan Tweaks
; Allows insecure guest (unauthenticated) SMB logons to access older NAS/shared folders on the LAN.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters]
"AllowInsecureGuestAuth"=dword:00000001

; Enable Network Shared Printer
; Restores RPC over named pipes and relaxes RPC privacy auth for print, fixing connections to older shared network printers.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows NT\Printers\RPC]
"RpcUseNamedPipeProtocol"=dword:00000001
"RpcProtocols"=dword:00000007
"ForceKerberosForRpc"=dword:00000001

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Print]
"RpcAuthnLevelPrivacyEnabled"=dword:00000000

; Increase Wallpaper Quality
; https://www.elevenforum.com/t/disable-desktop-wallpaper-jpeg-quality-reduction-in-windows-11.10782/
; Sets JPEG wallpaper import quality to 100% so wallpapers are not compressed.
[HKEY_CURRENT_USER\Control Panel\Desktop]
"JPEGImportQuality"=dword:00000064

; Check "Do This For All Current Items" in File Conflict Dialog
; https://www.elevenforum.com/t/check-or-uncheck-do-this-for-all-current-items-in-file-conflict-dialog-in-windows-11.26605/
; Pre-checks "Do this for all current items" in copy/move conflict dialogs.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\OperationStatusManager]
"ConfirmationCheckBoxDoForAll"=dword:00000001

; Show More Details In File Transfer
; https://www.elevenforum.com/t/show-fewer-details-or-more-details-in-file-transfer-dialog-in-windows-11.26604/
; Always opens the copy/move dialog with "More details" (speed graph) expanded.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\OperationStatusManager]
"EnthusiastMode"=dword:00000001

; Disable Resume
; https://www.elevenforum.com/t/enable-or-disable-resume-app-from-device-and-continue-on-windows-11-pc.29671/
; Turns off Resume, which offers to continue on the PC what you were doing in an app on your phone.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\CrossDeviceResume\Configuration]
"IsResumeAllowed"=dword:00000000

; Enable Settings Agent Search
; https://www.elevenforum.com/t/enable-or-disable-settings-search-agent-in-windows-11.39614/
; Removes the policy that blocks the AI agent in Settings search, restoring the default (enabled).
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsAI]
"DisableSettingsAgent"=-

; Disable Recall Snapshots Feature
; https://www.elevenforum.com/t/enable-or-disable-recall-feature-in-windows-11.30869/
; https://www.elevenforum.com/t/enable-or-disable-recall-snapshots-in-windows-11.25460/
; Blocks Recall from being enabled and stops saving snapshots (AI data analysis) for all users.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsAI]
"AllowRecallEnablement"=dword:00000000

[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\WindowsAI]
"DisableAIDataAnalysis"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsAI]
"DisableAIDataAnalysis"=dword:00000001

; Disable Click To Do
; https://www.elevenforum.com/t/enable-or-disable-click-to-do-in-windows-11.35166/
; Turns off Click to Do (Win + click screen actions) for the user and by machine policy.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\Shell\ClickToDo]
"DisableClickToDo"=dword:00000001

[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\WindowsAI]
"DisableClickToDo"=-

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsAI]
"DisableClickToDo"=dword:00000001

; Disable Copilot
; https://www.elevenforum.com/t/enable-or-disable-windows-copilot-in-windows-11.17045/
; https://www.elevenforum.com/t/add-or-remove-sidebar-in-microsoft-edge.4247/
; https://www.elevenforum.com/t/enable-or-disable-bing-web-suggested-search-results-in-windows-search-on-windows-11.5309/
; https://www.elevenforum.com/t/add-or-remove-copilot-button-on-taskbar-in-windows-11.16015/
; Turns off Windows Copilot, Edge sidebar, search box web suggestions, the taskbar Copilot button and Copilot auto-open on large screens.
[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\WindowsCopilot]
"TurnOffWindowsCopilot"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsCopilot]
"TurnOffWindowsCopilot"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"HubsSidebarEnabled"=dword:00000000

[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\Explorer]
"DisableSearchBoxSuggestions"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Explorer]
"DisableSearchBoxSuggestions"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowCopilotButton"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Notifications\Settings]
"AutoOpenCopilotLargeScreens"=dword:00000000

; Disable Copilot App Web Browsing & Cowork Automatic Actions
; https://www.elevenforum.com/t/enable-or-disable-web-browsing-in-copilot-app-on-windows-11.50094/
; https://www.elevenforum.com/t/enable-or-disable-copilot-cowork-to-automatically-take-actions-in-copilot-app-on-windows-11.50096/
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Copilot]
"BrowsingEnabled"=dword:00000000
"CopilotCoworkToolActionsEnabled"=dword:00000000

; Disable Location Services
; https://www.elevenforum.com/t/enable-or-disable-location-services-in-windows-11.3003/
; Turns off location services for the whole device.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location]
"Value"="Deny"

; Disable Location Allow Override
; https://www.elevenforum.com/t/enable-or-disable-allow-location-override-in-windows-11.18038/
; Turns off "Allow location override", so apps can't use location while location services are off.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\CPSS\Store\UserLocationOverridePrivacySetting]
"Value"=dword:00000000

; Disable Let Apps Access Your Location
; https://www.elevenforum.com/t/turn-on-or-off-let-apps-access-location-in-windows-11.3017/
; Turns off "Let apps access your location" for the current user.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location]
"Value"="Deny"

; Disable Notify When Apps Request Location
; https://www.elevenforum.com/t/turn-on-or-off-notify-when-apps-request-location-in-windows-11.18578/
; Stops the notification shown when an app tries to use location while it is blocked.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location]
"ShowGlobalPrompts"=dword:00000000

; Disable Required Diagnostic Data
; https://www.elevenforum.com/t/enable-or-disable-send-required-and-optional-diagnostic-data-for-windows-11.2621/
; Sets diagnostic data to the lowest level allowed by policy and limits the Settings maximum to Required.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Diagnostics\DiagTrack]
"ShowedToastAtLevel"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection]
"AllowTelemetry"=dword:00000001
"MaxTelemetryAllowed"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection]
"AllowTelemetry"=dword:00000000

; Enable Classic Search, Disable Enhanced Search
; https://www.elevenforum.com/t/turn-on-or-off-enhanced-mode-for-search-indexer-in-windows-11.2941/
; Sets search indexer to Classic (Libraries and Desktop only) instead of Enhanced (whole PC).
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Search\Gather\Windows\SystemIndex]
"EnableFindMyFiles"=dword:00000000

; Respect Power Modes For Search Indexer Performance
; https://www.elevenforum.com/t/turn-on-or-off-respect-power-settings-when-indexing-in-windows-11.2960/
; Makes the indexer follow power mode / battery saver settings and slow down when needed.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Search\Gather\Windows\SystemIndex]
"RespectPowerModes"=dword:00000001

; Restore Default Search Indexer Backoff During High System Activity
; https://www.elevenforum.com/t/enable-or-disable-search-indexer-backoff-in-windows-11.48551/
; Removes the override that prevents indexing from slowing down during heavy use.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Search]
"DisableBackoff"=-

; Disable Automatically Find Additional Relevant Search Index Locations
; https://www.elevenforum.com/t/enable-or-disable-automatically-find-additional-relevant-search-index-locations-in-windows-11.48468/
; https://www.elevenforum.com/t/remove-all-automatically-added-search-index-locations-in-windows-11.48917/
; Stops Windows Search from adding folders to the index on its own based on file activity (keeps Classic Search scope). Restart required.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Search\ScopeExpansion]
"Enabled"=dword:00000000

; Disable Search WebView Usage
; Feature override (ID 1694661260) that turns off WebView usage in Windows Search.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\FeatureManagement\Overrides\8\1694661260]
"EnabledState"=dword:00000001
"EnabledStateOptions"=dword:00000000
"Variant"=dword:00000000
"VariantPayload"=dword:00000000
"VariantPayloadKind"=dword:00000000

; Disable Showing Cloud Results In Search
; https://www.elevenforum.com/t/enable-or-disable-cloud-content-search-for-accounts-in-windows-11.5378/
; https://www.elevenforum.com/t/enable-or-disable-search-highlights-in-windows-11.5735/
; Turns off cloud content search for Microsoft and work/school accounts, web search and search highlights.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Search]
"AllowCloudSearch"=dword:00000000
"DisableWebSearch"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\SearchSettings]
"IsDynamicSearchBoxEnabled"=dword:00000000
"IsMSACloudSearchEnabled"=dword:00000000
"IsAADCloudSearchEnabled"=dword:00000000

; Turn Off Safe Search
; https://www.elevenforum.com/t/change-bing-safesearch-filters-in-windows-11.5389/
; Sets Bing SafeSearch in Windows Search to Off.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings]
"SafeSearchMode"=dword:00000000

; Turn Off Web Search
; https://www.elevenforum.com/t/enable-or-disable-bing-web-suggested-search-results-in-windows-search-on-windows-11.5309/
; Stops Windows Search from showing web suggestions.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings]
"IsWebSuggestionsEnabled"=dword:00000000

; Turn Off Bing Search by User Settings
; https://www.elevenforum.com/t/enable-or-disable-bing-web-suggested-search-results-in-windows-search-on-windows-11.5309/
; Turns off Bing results in Windows Search and stops search from using location.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Search]
"BingSearchEnabled"=dword:00000000
"AllowSearchToUseLocation"=dword:00000000

; Disable Microsoft Edge Tabs At Alt Tab
; https://www.elevenforum.com/t/change-number-of-tabs-from-apps-to-show-when-snapping-or-alt-tab-in-windows-11.3836/
; Shows only open windows in Alt+Tab and Snap Assist, not individual Edge tabs.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"MultiTaskingAltTabFilter"=dword:00000003

; Disable Emoji
; https://www.elevenforum.com/t/show-or-hide-emoji-and-more-icon-on-taskbar-system-tray-in-windows-11.31314/
; Hides the "Emoji and more" icon on the taskbar system tray.
[HKEY_CURRENT_USER\Software\Microsoft\TabletTip\1.7]
"EmojiAndMoreIconVisibilityState"=dword:00000000

; Disable Font Blocking
; https://www.elevenforum.com/t/enable-or-disable-untrusted-font-blocking-in-windows-11.12882/
; Removes the untrusted font blocking policy so fonts outside %windir%\Fonts are not blocked.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows NT\MitigationOptions]
"MitigationOptions_FontBlocking"=-

; Disable Pick Up Where You Left Off
; https://www.elevenforum.com/t/enable-or-disable-auto-sign-in-and-lock-after-update-or-restart-in-windows-11.3324/
; Stops Windows from auto signing in after updates/restarts to finish setup and reopen apps.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"DisableAutomaticRestartSignOn"=dword:00000001

; Disable Sync Provider Notification In File Explorer
; https://www.elevenforum.com/t/enable-or-disable-sync-provider-notifications-in-file-explorer-in-windows-11.5200/
; Hides OneDrive/Microsoft 365 promo banners (sync provider notifications) in File Explorer.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowSyncProviderNotifications"=dword:00000000

; Narrator Shortcut
; https://www.elevenforum.com/t/enable-or-disable-narrator-keyboard-shortcut-in-windows-11.6651/
; Turns off the Win + Ctrl + Enter shortcut that starts Narrator.
[HKEY_CURRENT_USER\Software\Microsoft\Narrator\NoRoam]
"WinEnterLaunchEnabled"=dword:00000000

; Disable Magnifier Shortcut (Win + Plus)
; https://www.elevenforum.com/t/enable-or-disable-magnifier-win-plus-keyboard-shortcut-in-windows-11.50359/
; Stops Win + Plus from accidentally launching Magnifier, like the Narrator shortcut above.
[HKEY_CURRENT_USER\Software\Microsoft\ScreenMagnifier]
"ShortcutKeyEnabled"=dword:00000000

; Launch To This PC
; https://www.elevenforum.com/t/change-folder-to-open-file-explorer-to-by-default-in-windows-11.675/
; Opens File Explorer to This PC instead of Home.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"LaunchTo"=dword:00000001

; Remove Duplicate Drives
; https://www.elevenforum.com/t/add-or-remove-duplicate-drives-in-navigation-pane-of-file-explorer-in-windows-11.3043/
; Removes duplicate removable drive entries shown separately in the File Explorer navigation pane.
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Desktop\NameSpace\DelegateFolders\{F5FB2C77-0E2F-4A16-A381-3E560C68BC83}]
[-HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\Desktop\NameSpace\DelegateFolders\{F5FB2C77-0E2F-4A16-A381-3E560C68BC83}]

; Enable Clipboard History
; https://www.elevenforum.com/t/enable-or-disable-clipboard-history-in-windows-11.973/
; Removes the policy that blocks Clipboard history (Win + V), allowing it to be used.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System]
"AllowClipboardHistory"=-

; Disable Power Throttling
; Turns off Power Throttling (EcoQoS), so background apps are not slowed down to save power.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling]
"PowerThrottlingOff"=dword:00000001

; Faster Turn On
; https://www.elevenforum.com/t/enable-or-disable-delay-of-running-startup-apps-in-windows-11.9144/
; Removes the delay before startup apps run after sign-in.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Serialize]
"StartupDelayInMSec"=dword:00000000

; Faster Turn Off
; https://www.elevenforum.com/t/turn-on-or-off-autoendtasks-at-sign-out-restart-shut-down-in-windows-11.8283/
; https://www.elevenforum.com/t/change-hungapptimeout-value-in-windows-11.8281/
; https://www.elevenforum.com/t/change-waittokillservicetimeout-value-in-windows-11.23092/
; Auto-closes hung apps and shortens app/service kill timeouts to 1 second for faster sign-out, restart and shut down; also shortens menu delay.
[HKEY_USERS\.DEFAULT\Control Panel\Desktop]
"AutoEndTasks"="1"
"HungAppTimeout"="1000"
"MenuShowDelay"="100"
"WaitToKillAppTimeout"="1000"
"LowLevelHooksTimeout"="1000"

[HKEY_CURRENT_USER\Control Panel\Desktop]
"AutoEndTasks"="1"
"HungAppTimeout"="1000"
"MenuShowDelay"="100"
"WaitToKillAppTimeout"="1000"
"LowLevelHooksTimeout"="1000"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control]
"WaitToKillServiceTimeout"="1000"

; Improve General Responsiveness & Disable Mouse Acceleration
; https://www.elevenforum.com/t/turn-on-or-off-enhance-pointer-precision-in-windows-11.7327/
; Turns off Enhance pointer precision (mouse acceleration) and shortens mouse hover time.
[HKEY_CURRENT_USER\Control Panel\Mouse]
"MouseHoverTime"="300"
"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"

; Disable Lets Finish Setting Up Your Device
; https://www.elevenforum.com/t/enable-or-disable-lets-finish-setting-up-your-device-in-windows-11.5205/
